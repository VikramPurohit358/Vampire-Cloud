PORT=8080
TOTAL_TASKS=100
DIFFICULTY=5
TASK_TIMEOUT_MS=30000
REWARD_PER_TASK=10
AUTO_REFILL=false
STATE_FILE=./data/ledger.json

# MongoDB Connection String:
# Local Docker: mongodb://mongodb:27017/vampire_cloud
# Free Cloud (MongoDB Atlas): mongodb+srv://<dbuser>:<dbpassword>@<cluster>.mongodb.net/vampire_cloud?retryWrites=true&w=majority
MONGODB_URI=mongodb://mongodb:27017/vampire_cloud
JWT_SECRET=vampire-secret-cloud-key-2026

# Dashboard <-> Master Connectivity:
# Local development:
# NEXT_PUBLIC_MASTER_API_URL=http://localhost:8080
# NEXT_PUBLIC_MASTER_WS_URL=ws://localhost:8080/observer
# Internet Cloud deployment (e.g. deployed on Render/Railway/Fly):
# NEXT_PUBLIC_MASTER_API_URL=https://your-master-service.onrender.com
# NEXT_PUBLIC_MASTER_WS_URL=wss://your-master-service.onrender.com/observer
NEXT_PUBLIC_MASTER_API_URL=http://localhost:8080
NEXT_PUBLIC_MASTER_WS_URL=ws://localhost:8080/observer

# Contributor Worker CLI:
# Local: ws://localhost:8080/worker
# Internet: wss://your-master-service.onrender.com/worker
VAMP_MASTER_URL=ws://localhost:8080/worker
VAMP_WALLET=0xDemoWallet
VAMP_NODE_NAME=vamp-worker
